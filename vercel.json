{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(icon-192|icon-512|icon-maskable-512|apple-touch-icon).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/peliculas",
      "destination": "/pages/peliculas.html"
    },
    {
      "source": "/series",
      "destination": "/pages/series.html"
    },
    {
      "source": "/anime",
      "destination": "/pages/anime.html"
    },
    {
      "source": "/jk",
      "destination": "/pages/jk.html"
    },
    {
      "source": "/buscar",
      "destination": "/pages/buscar.html"
    },
    {
      "source": "/favoritos",
      "destination": "/pages/favoritos.html"
    },
    {
      "source": "/historial",
      "destination": "/pages/historial.html"
    },
    {
      "source": "/perfil",
      "destination": "/pages/perfil.html"
    },
    {
      "source": "/reproductor",
      "destination": "/pages/reproductor.html"
    },
    {
      "source": "/trailer",
      "destination": "/pages/trailer.html"
    },
    {
      "source": "/cuenta",
      "destination": "/pages/cuenta.html"
    },
    {
      "source": "/privacidad",
      "destination": "/pages/privacidad.html"
    }
  ]
}

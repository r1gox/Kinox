{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/peliculas", "destination": "/pages/peliculas.html" },
    { "source": "/series", "destination": "/pages/series.html" },
    { "source": "/anime", "destination": "/pages/anime.html" },
    { "source": "/jk", "destination": "/pages/jk.html" },
    { "source": "/buscar", "destination": "/pages/buscar.html" },
    { "source": "/favoritos", "destination": "/pages/favoritos.html" },
    { "source": "/historial", "destination": "/pages/historial.html" },
    { "source": "/perfil", "destination": "/pages/perfil.html" },
    { "source": "/pelicula/:id", "destination": "/pages/detalle-pelicula.html?id=:id" },
    { "source": "/serie/:id", "destination": "/pages/detalle-serie.html?id=:id" },
    { "source": "/reproductor", "destination": "/pages/reproductor.html" },
    { "source": "/trailer", "destination": "/pages/trailer.html" }
  ]
}
